# Ultimate Swing Trader — Environment Variables
# Copy this to .env and fill in your keys.
# .env is gitignored and will NOT be committed.
#
# This project is long-only swing trading. There are no day-trading, mode
# switching, short, margin, options, or crypto settings — they do not exist
# and adding them will not enable those behaviours.

# Adaptive swing safety defaults
TRADING_STYLE=swing
EXECUTION_MODE=paper
TRADING_ENABLED=false
# Gates whether crash-watchdog-agent may push a mechanical fix straight to
# main, vs. always opening a PR instead. Same off-by-default pattern as
# TRADING_ENABLED -- flip on only after reviewing its judgment on a few real
# incidents. See docs/CRON_AGENTS.md.
WATCHDOG_AUTO_PUSH_ENABLED=false
STRATEGY_VERSION=SWING_V1.0
CONFIG_VERSION=SWING_CONFIG_V1
SCANNER_VERSION=deterministic-swing-scanner-v2
LIVE_TRADING_ACK=

# Risk limits. Values may be made stricter; startup rejects weaker ceilings/floors.
NORMAL_RISK_PCT=0.0075
ABSOLUTE_MAX_RISK_PCT=0.01
REDUCED_RISK_PCT=0.003
REDUCE_RISK_DRAWDOWN_PCT=0.05
HALT_DRAWDOWN_PCT=0.08
MAX_COMBINED_OPEN_RISK_PCT=0.02
MAX_SECTOR_OPEN_RISK_PCT=0.015
MAX_CLUSTER_OPEN_RISK_PCT=0.01
MAX_POSITION_EXPOSURE_PCT=0.35
MAX_OPEN_POSITIONS=3
MAX_NEW_POSITIONS_DAY=1
MAX_NEW_POSITIONS_WEEK=3
CONSECUTIVE_LOSS_HALT=3
WEEKLY_DRAWDOWN_HALT_PCT=0.04
MINIMUM_STOP_ATR=0.75
MAXIMUM_STOP_ATR=3.0
MAXIMUM_ADV_FRACTION=0.001
BROKER_MIN_QUANTITY=1
MINIMUM_RR=2.0
BUY_SCORE_THRESHOLD=70
PREFERRED_SCORE_THRESHOLD=85
A_PLUS_SCORE_THRESHOLD=90
BORDERLINE_SCORE_THRESHOLD=60
QUOTE_FRESHNESS_SECONDS=300
# Pre-execution safety freshness defaults. Missing timestamps reject; values are seconds.
BROKER_ASSET_FRESHNESS_SECONDS=60
MARKET_CLOCK_FRESHNESS_SECONDS=60
CORPORATE_EVENT_FRESHNESS_SECONDS=86400
EARNINGS_FRESHNESS_SECONDS=86400
MAXIMUM_ENTRY_SLIPPAGE_R=0.25
EARNINGS_EXCLUSION_TRADING_DAYS=5
COOLDOWN_TRADING_DAYS=10
MINIMUM_STATISTICAL_SAMPLE=30
MAXIMUM_SCANNER_CANDIDATES=20
MAXIMUM_PM_CANDIDATES=5

# Position lifecycle and named stop/time policies. REVIEW is the conservative operational default.
EXPECTED_HOLD_DAYS=4
MAXIMUM_HOLD_DAYS=10
TIME_STOP_MINIMUM_PROGRESS_R=0.50
TIME_STOP_MODE=REVIEW
STOP_MANAGEMENT_POLICY=STRUCTURE_THEN_TRAIL
PROFITABLE_TRIGGER_R=1.0
TRAILING_ACTIVATION_R=2.0
TRAILING_DISTANCE_R=0.75
# Blank means no folklore breakeven rule is enabled.
MOVE_TO_BREAKEVEN_AT_R=
TRAILING_ELIGIBLE_SETUPS=TREND_PULLBACK,RELATIVE_STRENGTH_CONTINUATION
MINIMUM_PRICE=5
MINIMUM_AVERAGE_VOLUME=1000000
MINIMUM_AVERAGE_DOLLAR_VOLUME=20000000
MINIMUM_HISTORY_SESSIONS=160
MAXIMUM_SPREAD_PCT=0.005
SWING_UNIVERSE_PATH=config/universe/us_liquid_2026-08-11.csv
DO_NOT_TRADE_PATH=config/do_not_trade.yaml
SWING_DATABASE_PATH=data/adaptive_swing.db

# Deterministic validator research defaults. Every value is startup-bounded;
# see docs/refactor/02_STRATEGY_REPORT.md for ranges and rationale.
STRATEGY_SHORT_EMA_PERIOD=20
STRATEGY_ATR_PERIOD=14
STRATEGY_MEDIUM_MA_PERIOD=50
STRATEGY_LONG_MA_PERIOD=150
STRATEGY_TREND_SLOPE_LOOKBACK=10
STRATEGY_MINIMUM_TREND_SLOPE=0
STRATEGY_RS_LOOKBACK=63
STRATEGY_MINIMUM_SPY_RS=0
STRATEGY_STRONG_SPY_RS=0.03
STRATEGY_MINIMUM_SECTOR_RS=0
STRATEGY_PULLBACK_MAX_ATR_DISTANCE=1.25
STRATEGY_STRUCTURAL_BREAK_ATR=0.5
STRATEGY_MINIMUM_ATR_PCT=0.005
STRATEGY_MAXIMUM_ATR_PCT=0.08
STRATEGY_CONSOLIDATION_SESSIONS=20
STRATEGY_CONSOLIDATION_MAX_RANGE_PCT=0.12
STRATEGY_BREAKOUT_BUFFER_PCT=0.003
STRATEGY_BREAKOUT_VOLUME_RATIO=1.20
STRATEGY_RETEST_HOLD_TOLERANCE_PCT=0.01
STRATEGY_RETEST_COLLAPSE_TOLERANCE_PCT=0.03
STRATEGY_MAXIMUM_BREAKOUT_EXTENSION_ATR=1.25
STRATEGY_RS_CONSOLIDATION_SESSIONS=10
STRATEGY_RS_CONSOLIDATION_MAX_ATR=4.0
STRATEGY_CONTRACTION_VOLUME_RATIO=0.90
STRATEGY_CONFIRMATION_VOLUME_RATIO=1.10
STRATEGY_TREND_TARGET_ATR_EXTENSION=3.0
STRATEGY_MEASURED_MOVE_MULTIPLE=2.5
STRATEGY_MAXIMUM_BAR_AGE_DAYS=7

SCORE_WEIGHT_SETUP_QUALITY=30
SCORE_WEIGHT_RELATIVE_STRENGTH=20
SCORE_WEIGHT_TREND_QUALITY=15
SCORE_WEIGHT_VOLUME_CONFIRMATION=10
SCORE_WEIGHT_MARKET_REGIME=10
SCORE_WEIGHT_SECTOR_STRENGTH=5
SCORE_WEIGHT_RISK_REWARD=10
NEUTRAL_SCORE_THRESHOLD_ADDITION=5
CHOPPY_SCORE_THRESHOLD_ADDITION=10
HOSTILE_SCORE_THRESHOLD_ADDITION=20
NEUTRAL_RISK_MULTIPLIER=0.75
CHOPPY_RISK_MULTIPLIER=0.50
HOSTILE_RISK_MULTIPLIER=0.25

# Model routing. Empty roles fail gracefully to NO_TRADE. Every role is
# independently overridable -- these are recommended defaults, not fixed
# requirements. Routine per-candidate analysis uses the cheaper Sonnet tier;
# roles that need deeper reasoning (final buy/sell decision, postmortem
# root-cause judging, strategy research) default to the Opus tier.
SCANNER_MODEL=
ANALYST_MODEL=claude-sonnet-5
PORTFOLIO_MANAGER_MODEL=claude-opus-5
POSTMORTEM_MODEL=claude-opus-5
RESEARCH_MODEL=claude-opus-5
MODEL_FALLBACK=claude-sonnet-5
LLM_MATERIAL_SCORE_CHANGE=5

# Weekday schedule in America/New_York. The scheduler must interpret these as
# named-zone times (not fixed UTC offsets) so DST does not shift market jobs.
SCHEDULE_TIMEZONE=America/New_York
SCHEDULE_INITIAL_SCAN_ET=09:35
SCHEDULE_DECISION_CYCLE_ET=10:15
SCHEDULE_MIDDAY_REFRESH_ET=12:30
SCHEDULE_AFTERNOON_REFRESH_ET=14:30
SCHEDULE_POSITION_HEALTH_ET=15:45
SCHEDULE_DAILY_REPORT_ET=16:15
SCHEDULE_WEEKLY_LESSONS_ET=Sunday 18:00

# Alpaca paper trading (required only for broker-backed status/reconciliation/execution)
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Hosted database (Turso) — optional. If TURSO_DATABASE_URL is unset,
# src/swing/database.py falls back to the local SQLite file at
# SWING_DATABASE_PATH. Cloud routines need this set: they have no
# persistent disk and no working git-push credentials, so a local-file
# database can't carry state between runs. See docs/CRON_AGENTS.md.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# The supported swing decision backend. Blank means deterministic-only/NO_TRADE
# behavior wherever a structured model is required.
#
# In the scheduled cloud routines' "Environment variables" box specifically
# (see docs/CRON_AGENTS.md), the platform reserves the exact name
# ANTHROPIC_API_KEY for its own Claude Code session authentication and does
# NOT pass it through to the sandbox process -- confirmed directly, a real
# key entered under that exact name still reads as unset inside the
# sandbox. Set SWING_ANTHROPIC_API_KEY there instead (checked first, see
# llm_backend.resolve_anthropic_api_key). Local dev, a plain .env file, and
# other environments without that collision can keep using the plain name
# below.
ANTHROPIC_API_KEY=
SWING_ANTHROPIC_API_KEY=

# Telegram notifications (optional). Every completed `swing-trader run` emits
# a durable notification row either way; if either value below is unset,
# delivery is simply disabled and the row stays PENDING. Create a bot via
# @BotFather, message it once, then call getUpdates to find your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
